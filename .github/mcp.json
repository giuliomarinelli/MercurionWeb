{
  "mcpServers": {
    "chrome-devtools": {
      "type": "local",
      "command": "pwsh",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-NonInteractive",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".github/scripts/start-chrome-devtools-mcp.ps1"
      ]
    }
  }
}
