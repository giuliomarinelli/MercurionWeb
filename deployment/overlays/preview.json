{
  "environment": "preview",
  "services": {
    "web-ng": {
      "enabled": true,
      "target": "staging",
      "env": {
        "NODE_ENV": "production",
        "APP_ENV": "staging"
      }
    },
    "web-node": {
      "enabled": true,
      "target": "staging",
      "env": {
        "NODE_ENV": "production",
        "APP_ENV": "staging",
        "APP_PORT": "8098",
        "APP_HOST": "0.0.0.0"
      }
    },
    "redis": {
      "enabled": true,
      "env": {
        "REDIS_PASSWORD": "${REDIS_PASSWORD}"
      }
    },
    "nats": {
      "enabled": true,
      "env": {}
    },
    "postgres": {
      "enabled": true,
      "env": {
        "POSTGRES_USER": "${POSTGRES_USER}",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "POSTGRES_DB": "${POSTGRES_DB}"
      }
    },
    "meilisearch": {
      "enabled": true,
      "env": {
        "MEILI_MASTER_KEY": "${MEILI_MASTER_KEY}"
      }
    },
    "nginx": {
      "enabled": true,
      "env": {}
    },
    "tox21": {
      "enabled": true,
      "env": {
        "PY_ENV": "staging",
        "NATS_URL": "${TOX21_NATS_URL}",
        "VERSION": "${TOX21_VERSION}"
      }
    }
  }
}