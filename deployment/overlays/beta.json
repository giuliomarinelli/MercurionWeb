{
  "environment": "beta",
  "services": {
    "web-ng": { "enabled": true, "target": "staging", "env": { "NODE_ENV": "production", "APP_ENV": "staging" } },
    "web-node": { "enabled": true, "target": "staging", "env": { "NODE_ENV": "production", "APP_ENV": "staging", "APP_PORT": "8098", "APP_HOST": "0.0.0.0" } },
    "redis": { "enabled": true, "env": { "REDIS_PASSWORD": "${REDIS_PASSWORD}" } },
    "nats": { "enabled": true, "env": {} },
    "postgres": { "enabled": true, "env": { "POSTGRES_USER": "${POSTGRES_USER}", "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}", "POSTGRES_DB": "${POSTGRES_DB}" } },
    "meilisearch": { "enabled": true, "env": { "MEILI_MASTER_KEY": "${MEILI_MASTER_KEY}" } },
    "nginx": { "enabled": true, "env": {} },
    "tox21": { "enabled": true, "env": { "PY_ENV": "staging", "NATS_URL": "nats://nats-sl:4222", "VERSION": "${TOX21_VERSION}" } }
  }
}
