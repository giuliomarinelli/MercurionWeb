{
  "manifest_version": 3,
  "name": "Mercurion Maintenance Bypass",
  "description": "Aggiunge l'header X-Mercurion-Bypass solo per mercurion.app",
  "version": "1.0.0",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://mercurion.app/*",
    "https://*.mercurion.app/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules_1.json"
      }
    ]
  },
  "icons": {
    "32": "icon32.png",
    "128": "icon128.png"
  }
}
