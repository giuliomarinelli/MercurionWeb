{
  "manifest_version": 2,
  "name": "Mercurion Maintenance Admin",
  "version": "1.0.0",
  "description": "Aggiunge l'header X-Mercurion-Admin solo per mercurion.app",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "https://mercurion.app/*",
    "https://*.mercurion.app/*"
  ],
  "background": {
    "scripts": ["background.js"]
  }
}
