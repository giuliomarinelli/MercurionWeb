  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "ng": "ng",
    "start:dev": "ng serve --serve-path /",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --karma-config=karma.conf.js",
    "test:onpush": "ng test --watch=false --ts-config src/tsconfig.onpush.spec.json",
    "lint": "eslint \"src/**/*.{ts,html}\"",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "private": true,
  "dependencies": {
