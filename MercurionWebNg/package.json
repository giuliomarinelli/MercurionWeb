    "@angular/build": "20.3.32",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.30",
    "@types/jasmine": "5.1.0",
    "angular-eslint": "20.7.0",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
