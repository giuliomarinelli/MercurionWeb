{
  "name": "mercurion_web_ng",
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "ng": "ng",
    "prestart:dev": "node ../scripts/build-identity.mjs",
    "start:dev": "ng serve --serve-path /",
    "prebuild": "node ../scripts/build-identity.mjs",
    "build": "ng build --stats-json",
    "pretypecheck": "node ../scripts/build-identity.mjs",
    "pretest": "node ../scripts/build-identity.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "pretest:accessibility": "node ../scripts/build-identity.mjs",
    "test:accessibility": "ng test --watch=false --karma-config=karma.conf.js --include=src/app/testing/accessibility-canonical-ui.spec.ts",
    "test:ci": "npm run test:coverage",
    "pretest:coverage": "node ../scripts/build-identity.mjs",
    "test:coverage": "ng test --watch=false --karma-config=karma.conf.js --code-coverage && node ../scripts/check-coverage-gates.mjs --project angular --coverage-dir MercurionWebNg/coverage/angular",
    "test:onpush": "ng test --watch=false --ts-config src/tsconfig.onpush.spec.json",
    "lint": "npm run lint:angular",
    "lint:angular": "eslint \"src/**/*.{ts,html}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "graphql:generate": "graphql-codegen --config codegen.yml",
    "graphql:validate": "node scripts/validate-graphql-documents.mjs",
    "graphql:validate:negative": "node scripts/test-graphql-validator-negative.mjs",
    "graphql:catalog-policy": "node scripts/check-graphql-catalog-policy.mjs",
    "graphql:catalog-policy:negative": "node scripts/test-graphql-catalog-policy-negative.mjs",
    "graphql:check": "npm run graphql:catalog-policy && npm run graphql:catalog-policy:negative && npm run graphql:validate && npm run graphql:validate:negative && graphql-codegen --config codegen.yml --check",
    "chemistry:check-lazy": "node scripts/check-chemistry-lazy-chunks.mjs",
    "bundle:check": "node scripts/check-bundle-gates.mjs",
    "storybook": "ng serve --configuration catalog --port 4400",
    "build-storybook": "ng build --configuration catalog",
    "ui:visual": "npm run build-storybook && node ../scripts/run-ui-visual.mjs",
    "ui:visual:update": "npm run build-storybook && node ../scripts/run-ui-visual.mjs --update-snapshots"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/forms": "20.3.30",
    "@angular/platform-browser": "20.3.30",
    "@angular/platform-browser-dynamic": "20.3.30",
    "@angular/router": "20.3.30",
    "@apollo/client": "3.13.8",
    "@mercurion/rest-contracts": "1.0.0",
    "@mercurion/socket-contracts": "1.0.0",
    "@rdkit/rdkit": "2024.3.5-1.0.0",
    "@thumbmarkjs/thumbmarkjs": "0.20.2",
    "apollo-angular": "10.0.3",
    "chart.js": "4.5.1",
    "graphql": "16.11.0",
    "jwt-decode": "4.0.0",
    "ngx-quill": "28.0.2",
    "ngx-skeleton-loader": "11.0.0",
    "prettier": "3.5.3",
    "quill": "2.0.2",
    "rxjs": "7.8.0",
    "smiles-drawer": "2.1.7",
    "socket.io-client": "4.8.1",
    "svg-country-flags": "1.2.10",
    "tslib": "2.3.0",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.32",
    "@angular/cli": "20.3.32",
    "@angular/compiler-cli": "20.3.30",
    "@graphql-codegen/add": "7.1.0",
    "@graphql-codegen/cli": "7.4.0",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@types/jasmine": "5.1.0",
    "angular-eslint": "20.7.0",
    "autoprefixer": "10.4.21",
    "axe-core": "4.11.0",
    "eslint": "9.39.5",
    "jasmine-core": "7.0.2",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "postcss": "8.5.24",
    "postcss-import": "16.1.0",
    "tailwindcss": "3.4.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.65.0"
  }
}
