{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.formatOnSave": true,

  // Migliora il supporto ai blocchi Angular inline
  "files.associations": {
    "*.component.ts": "typescript",
    "*.ts": "typescript"
  },

  // Abilita Angular Language Service (se installato)
  "angular.enable-strict-mode-prompt": false,

  // Prettier formatter specifico per Angular
  "prettier.documentSelectors": ["**/*.ts", "**/*.html"],

  // Formattazione coerente per i template
  "prettier.requireConfig": true
}
