LOAD DATABASE
  FROM mysql://root:root@host.docker.internal:3307/spectralume
  INTO postgresql://app:rootpassword@host.docker.internal:5431/mercurion
WITH
  include drop,
  create tables, create indexes, reset sequences,
  workers = 8, concurrency = 4,
  batch rows = 50000,
  multiple readers per thread,
  on error stop
CAST
  -- booleani
  type tinyint when (= precision 1) to boolean using tinyint-to-boolean,
  type tinyint to smallint drop typemod,
  -- tinyint generico
  type tinyint to smallint drop typemod,
  -- UNSIGNED (sintassi giusta: "when unsigned")
  type smallint when unsigned to integer drop typemod,
  type int      when unsigned to bigint  drop typemod,
  type bigint   when unsigned to numeric drop typemod,
  -- numerici
  type decimal   to numeric keep typemod,
  -- date/ora (zero-date -> NULL)
  type datetime  to timestamptz using zero-dates-to-null,
  type timestamp to timestamptz using zero-dates-to-null,
  -- json / set / enum
  type json to jsonb,
  type set  to text,
  type enum to text,
  -- binari
  type blob       to bytea,
  type mediumblob to bytea,
  type longblob   to bytea,
  type varbinary  to bytea
BEFORE LOAD DO
  $$ CREATE EXTENSION IF NOT EXISTS "uuid-ossp"; $$,
  $$ CREATE EXTENSION IF NOT EXISTS "citext"; $$,
  $$ CREATE EXTENSION IF NOT EXISTS "pgcrypto"; $$
AFTER LOAD DO
  $$ ANALYZE; $$;
