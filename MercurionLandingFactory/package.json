{
  "name": "mercurion-landing-factory",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npx @angular/cli@21 build && node __.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:MercurionLandingFactory": "node dist/MercurionLandingFactory/server/server.mjs"
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/platform-server": "21.2.26",
    "@angular/router": "21.2.26",
    "@angular/ssr": "21.2.29",
    "@tailwindcss/postcss": "4.3.3",
    "express": "5.2.1",
    "postcss": "8.5.28",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.26",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "glob@>=9": "14.0.4",
    "minimatch@>=7": "11.0.5"
  }
}
