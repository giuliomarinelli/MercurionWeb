# Mercurion - NestJS App Development Configuration

# 1 - AppConfig
APP_PORT=8099
APP_NATS_PORT=4223
APP_NATS_HOST=nats://localhost
APP_PROJECT_NAME=MercurionWebNode
APP_GLOBAL_NAME=Mercurion
APP_PROJECT_ID=728ca2de-8a78-4eb4-a95e-a3bba22fc29b
APP_CORS_ORIGINS=[]
APP_USER_ACTIVATION_ORIGIN=http://localhost:8888/m
APP_HOST=http://0.0.0.0
APP_SESSION_SIGNATURE_SECRET=<random_64bytes:base_64>
APP_PASSWORD_PEPPER=<random_32bytes:base_64>
APP_REDIS_ID_HMAC_SECRET=<random_32bytes:base_64>
APP_AES_SECRET=<random_32bytes:base_64>
APP_VERSION=1.0.0d
APP_DEVICE_ID_SIGNATURE_SECRET=<random_32bytes:base_64>
APP_SUPPORT_EMAIL=mercurion.app@gmail.com
APP_MAX_NATS_PAYLOAD_BYTES=4096

# 2 - DataConfig 
# PostgreSQL - SQL_DB
SQL_DATABASE_TYPE=postgres
SQL_DATABASE_HOST=localhost
SQL_DATABASE_PORT=5431
SQL_DATABASE_USERNAME=app
SQL_DATABASE_PASSWORD=<password>
SQL_DATABASE=mercurion
SQL_DATABASE_SYNCHRONIZE=false
SQL_DATABASE_LOGGING=false
SQL_DATABASE_LOGGER=advanced-console

# 3 - JwtConfig
# Secrets
# Access Token e WS AccessToken usano RSA key pair
JWT_SECRETS_PRE_AUTHORIZATION_TOKEN=<random_64bytes:base_64>
JWT_SECRETS_ACTIVATION_TOKEN=<random_64bytes:base_64>
JWT_SECRETS_PHONE_NUMBER_VERIFICATION_TOKEN=<random_64bytes:base_64>
JWT_SECRETS_EMAIL_VERIFICATION_TOKEN=<random_64bytes:base_64>
JWT_SECRETS_EMAIL_MFA_ACTIVATION=<random_64bytes:base_64>
JWT_SECRETS_SMS_MFA_ACTIVATION=<random_64bytes:base_64>
JWT_SECRETS_APP_MFA_ACTIVATION=<random_64bytes:base_64>
JWT_SECRETS_EMAIL_MFA_INACTIVATION=<random_64bytes:base_64>
JWT_SECRETS_SMS_MFA_INACTIVATION=<random_64bytes:base_64>
JWT_SECRETS_APP_MFA_INACTIVATION=<random_64bytes:base_64>
JWT_SECRETS_CHANGE_PASSWORD=<random_64bytes:base_64>
JWT_SECRETS_ACCOUNT_RECOVERY=<random_64bytes:base_64>
JWT_SECRETS_SSO_PRE_AUTHORIZATION_TOKEN=<random_64bytes:base_64>

# ExpirationsInMs # 900000
JWT_EXPIRATION_ACCESS_TOKEN=7200000
JWT_EXPIRATION_WS_ACCESS_TOKEN=7200000
# legacy: unused
JWT_EXPIRATION_REFRESH_TOKEN=2592000000
JWT_EXPIRATION_PRE_AUTHORIZATION_TOKEN=300000
JWT_EXPIRATION_ACTIVATION_TOKEN=7200000
JWT_EXPIRATION_PHONE_NUMBER_VERIFICATION_TOKEN=120000
JWT_EXPIRATION_EMAIL_VERIFICATION_TOKEN=120000
JWT_EXPIRATION_CHANGE_PASSWORD=300000
JWT_EXPIRATION_ACCOUNT_RECOVERY=600000
JWT_EXPIRATION_SSO_PRE_AUTHORIZATION_TOKEN=120000
MFA_CHANGE_TIME=300000
# Other JWT configs
JWT_AUD_API=mercurion-api
JWT_AUD_WS=mercurion-ws
JWT_AUD_AUTH=mercurion-auth

# 4 - SecureCookieConfig
SECURE_COOKIE_PATH=/
SECURE_COOKIE_HTTP_ONLY=true
SECURE_COOKIE_SAME_SITE=strict
SECURE_COOKIE_SECURE=false
SECURE_COOKIE_DOMAIN=localhost
SECURE_COOKIE_SECRET=<random_32bytes:base_64>

# 5 - EmailConfig
# legacy: unused
# EMAIL_HOST=gmail
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_USERNAME=mercurion.app@gmail.com
EMAIL_PASSWORD=<secret>
EMAIL_DEFAULT_FROM="Mercurion" <mercurion.app@gmail.com>   

# 6 - SmsConfig 
# Twilio
TWILIO_ACCOUNT_SID=<client_id>
TWILIO_AUTH_TOKEN=<secret>
TWILIO_NUMBER=+1 000 000 0000
TWILIO_FROM=Mercurion

# 7 - TotpConfig
TOTP_CONFIG_BYTES=32
TOTP_CONFIG_DIGITS=6
TOTP_CONFIG_PERIOD=120
TOTP_CONFIG_PEPPER=<random_32bytes:base_64>

# 8 - SessionConfig
SHORT_SESSION_LASTING=3600
PERSISTENT_SESSION_LASTING=2592000
SESSION_ZERO_ID=96488d68-3138-4eca-a6c8-4e11a53d72db

# 9 - DropboxConfig
DROPBOX_API_URL=https://api.dropboxapi.com/2
DROPBOX_AUTH_URL=https://www.dropbox.com/oauth2/authorize
DROPBOX_APP_KEY=<client_id>
DROPBOX_APP_SECRET=<secret>
DROPBOX_REDIRECT_URI=http://localhost:8888/api/oauth2/Dropbox/callback
DROPBOX_TOKEN_URL=https://api.dropboxapi.com/oauth2/token

# 10 - Meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=<secret>

# 11 - Cloudflare
CLOUDFLARE_SECRET_KEY=<secret>

# 12 - Redis
REDIS_HOST=localhost
REDIS_PORT=6378
REDIS_PASSWORD=<password>

# 13 - SSO
# Google
GOOGLE_CLIENT_ID=<client_id>
GOOGLE_CLIENT_SECRET=<client_secret>
GOOGLE_REDIRECT_URI=http://localhost:8888/api/oauth2/sso/Google/callback
# GitHub
GITHUB_CLIENT_ID=<client_id>
GITHUB_CLIENT_SECRET=<client_secret>
GITHUB_REDIRECT_URI=http://localhost:8888/api/oauth2/sso/GitHub/callback
# LinkedIn
LINKEDIN_CLIENT_ID=<client_id>
LINKEDIN_CLIENT_SECRET=<client_secret>
LINKEDIN_REDIRECT_URI=http://localhost:8888/api/oauth2/sso/LinkedIn/callback
# Discord
DISCORD_CLIENT_ID=<client_id>
DISCORD_CLIENT_SECRET=<client_secret>
DISCORD_REDIRECT_URI=http://localhost:8888/api/oauth2/sso/Discord/callback
