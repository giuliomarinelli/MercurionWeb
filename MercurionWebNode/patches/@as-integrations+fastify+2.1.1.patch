+        reply.code(res.status ?? 200);
+
+        return res.body.kind === 'complete'
+          ? res.body.string
+          : reply.send(Readable.from(res.body.asyncIterator));
+      },
+    });
+  }, { name: '@as-integrations/fastify', fastify: '^5.x' });
