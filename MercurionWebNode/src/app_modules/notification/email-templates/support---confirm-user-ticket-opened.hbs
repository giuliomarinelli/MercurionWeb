{{#> layouts/email-shell title="Mercurion: autenticazione a più fattori" footer="Se non hai richiesto assistenza, puoi ignorare questa email."}}
<h1>Ciao {{userFirstName}}!</h1>
<p>E' stato aperto il ticket <strong>#{{ticketPublicId}}</strong>.</p>
<p style="text-align:left; font-size:13px; color:#6B7280; margin:0 0 20px;">Riceverai una risposta dal supporto entro 48-72 ore.</p>
<div class="button-wrapper"><a href="{{url}}" class="btn-primary">Apri Ticket</a></div>
<p class="muted">Se il pulsante non funziona, copia e incolla questo link nel tuo browser:</p>
<p class="fallback-link">{{url}}</p>
{{/layouts/email-shell}}
