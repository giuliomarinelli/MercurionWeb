<!DOCTYPE html>
<html lang="it">

<head>
  <title>Mercurion: autenticazione a più fattori</title>
  <meta charset="UTF-8" />
  <style>
    :root {
      color-scheme: light dark;
    }

    body {
      margin: 0;
      padding: 24px 0;
      background-color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    }

    .email-wrapper {
      max-width: 560px;
      margin: 0 auto;
      background-color: #F9FAFB;
      border-radius: 12px;
      border: 1px solid #E5E7EB;
      padding: 24px 24px 20px;
    }

    @media (prefers-color-scheme: dark) {
      body {
        background-color: #0a0a0a;
      }

      .email-wrapper {
        background-color: #1F2937;
        border-color: #4B5563;
      }
    }

    .logo {
      text-align: left;
      margin-bottom: 24px;
      padding: 12px;
      background-color: #0a0a0a;
      border: 1px solid #696e76;
      border-radius: 15px;
      width: fit-content;
      box-shadow: 1px 1px 5px 1px #919191;
      margin: auto;
      margin-bottom: 24px;
    }

    .logo svg {
      display: block;
      width: 180px;
      height: auto;
    }

    .logo-dark {
      display: none;
    }

    @media (prefers-color-scheme: dark) {
      .logo-light {
        display: none !important;
      }

      .logo-dark {
        display: block !important;
      }
    }

    h1 {
      margin: 0 0 8px;
      font-size: 22px;
      line-height: 1.3;
      color: #11141D;
    }

    p {
      margin: 0 0 12px;
      font-size: 15px;
      line-height: 1.6;
      color: #4B5563;
    }

    @media (prefers-color-scheme: dark) {
      h1 {
        color: #F3F4F6;
      }

      p {
        color: #D1D5DB;
      }
    }

    .button-wrapper {
      margin: 24px 0 12px;
    }

    .btn-primary {
      display: inline-block;
      padding: 10px 20px;
      border-radius: 999px;
      background-color: #2563EB;
      color: #ffffff !important;
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
      text-align: center;
      min-width: 180px;
    }

    .btn-primary:hover {
      background-color: #1d4ed8;
    }

    @media (prefers-color-scheme: dark) {
      .btn-primary {
        background-color: #0B6DE5;
      }

      .btn-primary:hover {
        background-color: #2563EB;
      }
    }

    .muted {
      font-size: 13px;
      color: #6B7280;
    }

    @media (prefers-color-scheme: dark) {
      .muted {
        color: #9CA3AF;
      }
    }

    .fallback-link {
      word-break: break-all;
      font-size: 13px;
      color: #2563EB;
    }

    @media (prefers-color-scheme: dark) {
      .fallback-link {
        color: #60A5FA;
      }
    }

    .footer {
      margin-top: 24px;
      border-top: 1px solid #E5E7EB;
      padding-top: 12px;
      font-size: 11px;
      color: #9CA3AF;
    }

    @media (prefers-color-scheme: dark) {
      .footer {
        border-top-color: #4B5563;
        color: #6B7280;
      }
    }
  </style>
</head>

