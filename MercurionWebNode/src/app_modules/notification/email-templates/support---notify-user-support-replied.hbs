{{#> layouts/email-shell title="Mercurion: assistenza" footer="Se non hai richiesto assistenza, puoi ignorare questa email."}}
<h1>Ciao {{userFirstName}}!</h1>
<p>Il ticket <strong>#{{ticketPublicId}}</strong> ha ricevuto una nuova risposta.</p>
{{#if ticketMessageBody}}
<p class="message-excerpt">{{ticketMessageBody}}</p>
{{/if}}
<div class="button-wrapper"><a href="{{url}}" class="btn-primary">Apri il ticket</a></div>
<p class="muted">Se il pulsante non funziona, copia e incolla questo link nel tuo browser:</p>
<p class="fallback-link">{{url}}</p>
{{/layouts/email-shell}}
