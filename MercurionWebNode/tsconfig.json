{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    // Temporary compatibility debt: migrate catch blocks to narrow unknown errors before enabling this.
    "useUnknownInCatchVariables": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false
  }
}
