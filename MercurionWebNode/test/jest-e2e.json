{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^jose$": "<rootDir>/../src/test-utils/mocks/jose.ts",
    "^content-disposition$": "<rootDir>/content-disposition.cjs"
  },
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  }
}
